{
    "debug": true,
    "archinstall-language": "English",
    "script": "guided",
    "silent": false,
    "hostname": "arch-host",
    "timezone": "Europe/Helsinki",
    "ntp": true,
    "bootloader_config": {
        "bootloader": "Systemd-boot",
        "uki": false
    },
    "kernels": [
        "linux"
    ],
    "locale_config": {
        "kb_layout": "fi",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US"
    },
    "network_config": {
	    "type": "nm"
    },
    "mirror_config": {
        "mirror_regions": {
            "Worldwide": [
                "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
            ]
        }
    },
    "packages": [
        "networkmanager",
        "curl",
        "git",
        "sudo",
        "openssh",
        "neovim"
    ],
    "disk_config": {
        "config_type": "default_layout",
        "defice": "/dev/vda",
        "disk_encryption": null,
        "filesystem": "ext4"
    },
    "swap": {
        "enabled": false,
        "algorithm": "zstd"
    }
}
