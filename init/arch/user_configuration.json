{
    "bootloader": "Systemd-boot",
    "hostname": "arch-host",
    "keyboard-layout": "fi",
    "mirror-region": {
        "Worldwide": [
            "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
        ]
    },
    "nic": {
        "NetworkManager": true
    },
    "packages": [
        "git",
        "sudo",
        "networkmanager",
        "openssh",
        "neovim",
        "curl"
    ],
    "disk_config": {
        "config_type": "default_layout",
        "defice": "/dev/vda",
        "disk_encryption": null,
        "filesystem": "ext4",
    },
    "timezone": "Europe/Helsinki"
}
