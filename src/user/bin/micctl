#!/bin/bash
# Tuomo Björk
#
# 'micctl' (Microphone Control)
# version 1
# Requires: envsubst, pactl, systemctl --user
#
# Microphone Control enabling local filtering, monitoring,
# and transmission via sidechannel between hosts using VBAN (e.g. Remote Desktop).
#
# CHANGELOG:
# - version 1, 2026-09-11: First merge of monitoring, filter, and TX/RX.
set -eu

MICCTL_VERSION=1

# --- names ---------------------------------------------------------------
export MIC_HARDWARE_SOURCE="${MIC_HARDWARE_SOURCE:-alsa_input.usb-RODE_Microphones_RODE_NT-USB-00.analog-stereo}"
export MIC_HARDWARE_JACK="${MIC_HARDWARE_JACK:-alsa_output.usb-RODE_Microphones_RODE_NT-USB-00.analog-stereo}"
export MIC_FILTERED_NAME="${MIC_FILTERED_NAME:-mic_filtered}"
export MIC_FILTERED_DESC="${MIC_FILTERED_DESC:-Mic Filtered}"
export MIC_FILTERED_CAPTURE_NAME="${MIC_FILTERED_CAPTURE_NAME:-${MIC_FILTERED_NAME}_capture}"
export MIC_REMOTE_NAME="${MIC_REMOTE_NAME:-mic_remote}"
export MIC_REMOTE_DESC="${MIC_REMOTE_DESC:-Mic Remote}"
export MIC_VBAN_SINK="${MIC_VBAN_SINK:-vban_${MIC_REMOTE_NAME}}"

# --- DeepFilter + LSP ----------------------------------------------------
export MIC_DF_PLUGIN="${MIC_DF_PLUGIN:-/usr/lib64/libdeep_filter_ladspa.so}"
export MIC_DF_ATTEN="${MIC_DF_ATTEN:-48}"
export MIC_LSP_PLUGIN="${MIC_LSP_PLUGIN:-/usr/lib64/ladspa/lsp-plugins-ladspa.so}"
export MIC_COMP_LABEL="${MIC_COMP_LABEL:-http://lsp-plug.in/plugins/ladspa/compressor_stereo}"
export MIC_LIMIT_LABEL="${MIC_LIMIT_LABEL:-http://lsp-plug.in/plugins/ladspa/limiter_stereo}"
export MIC_COMP_MODE="${MIC_COMP_MODE:-2}"
export MIC_COMP_RATIO="${MIC_COMP_RATIO:-2}"
export MIC_COMP_THRESH="${MIC_COMP_THRESH:-0.25}"
export MIC_COMP_ATTACK="${MIC_COMP_ATTACK:-20}"
export MIC_COMP_RELEASE="${MIC_COMP_RELEASE:-180}"
export MIC_COMP_MAKEUP="${MIC_COMP_MAKEUP:-2.2}"
export MIC_COMP_LOOKAHEAD="${MIC_COMP_LOOKAHEAD:-5}"
export MIC_LIMIT_THRESH="${MIC_LIMIT_THRESH:-0.79}"
export MIC_LIMIT_LOOKAHEAD="${MIC_LIMIT_LOOKAHEAD:-5}"

# --- VBAN ----------------------------------------------------------------
# MIC_VBAN_DEST is required for TX. Change it to the Remote Host's IP.
export MIC_VBAN_DEST="${MIC_VBAN_DEST:-192.168.10.14}" # <- EDIT HERE
export MIC_VBAN_BIND="${MIC_VBAN_BIND:-0.0.0.0}"
export MIC_VBAN_PORT="${MIC_VBAN_PORT:-6980}"
export MIC_VBAN_SESS="${MIC_VBAN_SESS:-${MIC_REMOTE_NAME}}"
export MIC_VBAN_RX_LATENCY="${MIC_VBAN_RX_LATENCY:-40}"
export MIC_VBAN_TX_LATENCY="${MIC_VBAN_TX_LATENCY:-10}"

PW_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d"
FILTER_CONF="$PW_DIR/99-${MIC_FILTERED_NAME}.conf"
RX_CONF="$PW_DIR/80-vban-rx.conf"
TX_CONF="$PW_DIR/81-vban-tx.conf"
MON_STATE=/tmp/micctl-monitor.module
TX_STATE=/tmp/micctl-vban-tx.module


usage() {
    printf '%s\n' \
        "micctl $MICCTL_VERSION" \
        "Usage:" \
        "  micctl status" \
        "  micctl filter install|remove" \
        "  micctl monitor hardware|filtered|remote|stop" \
        "  micctl rx on|off" \
        "  micctl tx on|off" \
        "" \
        "Env (common): MIC_HARDWARE_SOURCE MIC_FILTERED_NAME MIC_REMOTE_NAME" \
        "Filter:       MIC_DF_ATTEN MIC_COMP_* MIC_LIMIT_*" \
        "VBAN:         MIC_VBAN_DEST MIC_VBAN_BIND MIC_VBAN_PORT MIC_VBAN_RX_LATENCY"
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "missing command: $1" >&2
        exit 1
    }
}

have_source() { pactl list short sources 2>/dev/null | grep -Fq "$1"; }
have_sink()   { pactl list short sinks 2>/dev/null | grep -Fq "$1"; }

module_alive() {
    [ -f "$1" ] || return 1
    ID=$(cat "$1")
    [ -n "$ID" ] || return 1
    pactl list short modules 2>/dev/null | awk '{print $1}' | grep -qx "$ID"
}

unload_state() {
    FILE=$1
    [ -f "$FILE" ] || return 0
    ID=$(cat "$FILE")
    pactl unload-module "$ID" 2>/dev/null || true
    rm -f "$FILE"
    [ -n "$ID" ] && echo "unloaded module $ID"
}

reload_pw() {
    echo "restarting pipewire"
    systemctl --user restart pipewire pipewire-pulse wireplumber
    i=0
    while [ "$i" -lt 20 ]; do
        pactl info >/dev/null 2>&1 && return 0
        i=$((i + 1))
        sleep 0.2
    done
    echo "pipewire did not come back" >&2
    exit 1
}

wait_source() {
    NAME=$1
    i=0
    while [ "$i" -lt 25 ]; do
        have_source "$NAME" && return 0
        i=$((i + 1))
        sleep 0.2
    done
    return 1
}

wait_sink() {
    NAME=$1
    i=0
    while [ "$i" -lt 25 ]; do
        have_sink "$NAME" && return 0
        i=$((i + 1))
        sleep 0.2
    done
    return 1
}

# --- templates -----------------------------------------------------------
filter_template() {
    cat <<'EOF'
# generated by micctl — filter
context.modules = [
    { name = libpipewire-module-filter-chain
        args = {
            node.description = "${MIC_FILTERED_DESC}"
            media.name       = "${MIC_FILTERED_DESC}"
            audio.rate       = 48000
            audio.channels   = 2
            audio.position   = [ FL FR ]
            filter.graph = {
                nodes = [
                    {
                        type   = ladspa
                        name   = df
                        plugin = ${MIC_DF_PLUGIN}
                        label  = deep_filter_stereo
                        control = { "Attenuation Limit (dB)" = ${MIC_DF_ATTEN} }
                    }
                    {
                        type   = ladspa
                        name   = comp
                        plugin = ${MIC_LSP_PLUGIN}
                        label  = "${MIC_COMP_LABEL}"
                        control = {
                            "Compression mode" = ${MIC_COMP_MODE}
                            "Ratio" = ${MIC_COMP_RATIO}
                            "Attack threshold (G)" = ${MIC_COMP_THRESH}
                            "Attack time (ms)" = ${MIC_COMP_ATTACK}
                            "Release time (ms)" = ${MIC_COMP_RELEASE}
                            "Makeup gain (G)" = ${MIC_COMP_MAKEUP}
                            "Sidechain lookahead (ms)" = ${MIC_COMP_LOOKAHEAD}
                        }
                    }
                    {
                        type   = ladspa
                        name   = lim
                        plugin = ${MIC_LSP_PLUGIN}
                        label  = "${MIC_LIMIT_LABEL}"
                        control = {
                            "Threshold (G)" = ${MIC_LIMIT_THRESH}
                            "Lookahead (ms)" = ${MIC_LIMIT_LOOKAHEAD}
                        }
                    }
                ]
                links = [
                    { output = "df:Audio Out L" input = "comp:Input L" }
                    { output = "df:Audio Out R" input = "comp:Input R" }
                    { output = "comp:Output L"  input = "lim:Input L" }
                    { output = "comp:Output R"  input = "lim:Input R" }
                ]
            }
            capture.props = {
                node.name     = "${MIC_FILTERED_CAPTURE_NAME}"
                node.passive  = true
                target.object = "${MIC_HARDWARE_SOURCE}"
            }
            playback.props = {
                node.name        = "${MIC_FILTERED_NAME}"
                node.description = "${MIC_FILTERED_DESC}"
                media.class      = "Audio/Source"
                audio.rate       = 48000
            }
        }
    }
]
EOF
}

rx_template() {
    cat <<'EOF'
# generated by micctl — vban rx
context.modules = [
    { name = libpipewire-module-vban-recv
        args = {
            source.ip           = ${MIC_VBAN_BIND}
            source.port         = ${MIC_VBAN_PORT}
            sess.latency.msec   = ${MIC_VBAN_RX_LATENCY}
            node.always-process = true
            stream.props = {
                media.class      = "Audio/Source"
                node.name        = "${MIC_REMOTE_NAME}"
                node.description = "${MIC_REMOTE_DESC}"
                audio.rate       = 48000
            }
            stream.rules = [
                { matches = [ { sess.name = "${MIC_VBAN_SESS}" } ]
                  actions = { create-stream = { sess.latency.msec = ${MIC_VBAN_RX_LATENCY} } } }
            ]
        }
    }
]
EOF
}

tx_template() {
    cat <<'EOF'
# generated by micctl — vban tx
context.modules = [
    { name = libpipewire-module-vban-send
        args = {
            destination.ip      = ${MIC_VBAN_DEST}
            destination.port    = ${MIC_VBAN_PORT}
            sess.name           = "${MIC_VBAN_SESS}"
            sess.min-ptime      = 1
            sess.latency.msec   = ${MIC_VBAN_TX_LATENCY}
            audio.rate          = 48000
            audio.channels      = 2
            audio.position      = [ FL FR ]
            node.always-process = true
            stream.props = {
                media.class      = "Audio/Sink"
                node.name        = "${MIC_VBAN_SINK}"
                node.description = "VBAN ${MIC_REMOTE_DESC}"
            }
        }
    }
]
EOF
}

FILTER_VARS='${MIC_HARDWARE_SOURCE} ${MIC_FILTERED_NAME} ${MIC_FILTERED_DESC} ${MIC_FILTERED_CAPTURE_NAME} ${MIC_DF_PLUGIN} ${MIC_DF_ATTEN} ${MIC_LSP_PLUGIN} ${MIC_COMP_LABEL} ${MIC_LIMIT_LABEL} ${MIC_COMP_MODE} ${MIC_COMP_RATIO} ${MIC_COMP_THRESH} ${MIC_COMP_ATTACK} ${MIC_COMP_RELEASE} ${MIC_COMP_MAKEUP} ${MIC_COMP_LOOKAHEAD} ${MIC_LIMIT_THRESH} ${MIC_LIMIT_LOOKAHEAD}'
RX_VARS='${MIC_VBAN_BIND} ${MIC_VBAN_PORT} ${MIC_VBAN_RX_LATENCY} ${MIC_REMOTE_NAME} ${MIC_REMOTE_DESC} ${MIC_VBAN_SESS}'
TX_VARS='${MIC_VBAN_DEST} ${MIC_VBAN_PORT} ${MIC_VBAN_SESS} ${MIC_VBAN_TX_LATENCY} ${MIC_VBAN_SINK} ${MIC_REMOTE_DESC}'

write_conf() {
    need envsubst
    mkdir -p "$PW_DIR"
    TMP=$(mktemp)
    $1 | envsubst "$2" > "$TMP"
    mv "$TMP" "$3"
    echo "wrote $3"
}

# --- status --------------------------------------------------------------
cmd_status() {
    echo "version  : $MICCTL_VERSION"
    echo "hardware : $MIC_HARDWARE_SOURCE"
    echo "filtered : $MIC_FILTERED_NAME  ($( [ -f "$FILTER_CONF" ] && echo installed || echo no-conf ))"
    echo "remote   : $MIC_REMOTE_NAME"
    echo "vban dest: ${MIC_VBAN_DEST:-unset}"
    echo "rx conf  : $( [ -f "$RX_CONF" ] && echo "$RX_CONF" || echo off )"
    echo "tx conf  : $( [ -f "$TX_CONF" ] && echo "$TX_CONF" || echo off )"
    echo "default  : $(pactl get-default-source 2>/dev/null || echo '?')"
    pactl list short sources 2>/dev/null | grep -E "$MIC_HARDWARE_SOURCE|$MIC_FILTERED_NAME|$MIC_REMOTE_NAME" || true
    have_sink "$MIC_VBAN_SINK" && echo "tx sink  : $MIC_VBAN_SINK" || true
    module_alive "$MON_STATE" && echo "monitor  : module $(cat "$MON_STATE")"
    module_alive "$TX_STATE" && echo "tx loop  : module $(cat "$TX_STATE")"
}

# --- filter --------------------------------------------------------------
cmd_filter() {
    case "${1:-}" in
        install)
            [ -f "$MIC_DF_PLUGIN" ] || { echo "missing $MIC_DF_PLUGIN" >&2; exit 1; }
            [ -f "$MIC_LSP_PLUGIN" ] || { echo "missing $MIC_LSP_PLUGIN" >&2; exit 1; }
            write_conf filter_template "$FILTER_VARS" "$FILTER_CONF"
            reload_pw
            if wait_source "$MIC_FILTERED_NAME"; then
                echo "ready $MIC_FILTERED_NAME"
            else
                echo "filter conf installed but $MIC_FILTERED_NAME did not appear" >&2
                exit 1
            fi
            ;;
        remove)
            rm -f "$FILTER_CONF"
            echo "removed $FILTER_CONF"
            reload_pw
            ;;
        *) echo "micctl filter install|remove" >&2; exit 1 ;;
    esac
}

# --- monitor -------------------------------------------------------------
cmd_monitor() {
    case "${1:-}" in
        stop)
            unload_state "$MON_STATE"
            echo "monitor stopped"
            ;;
        hardware|filtered|remote|"")
            TARGET=${1:-hardware}
            if module_alive "$MON_STATE"; then
                echo "monitor already running (module $(cat "$MON_STATE")). stop first." >&2
                exit 1
            fi
            case "$TARGET" in
                hardware) MIC=$MIC_HARDWARE_SOURCE ;;
                filtered) MIC=$MIC_FILTERED_NAME ;;
                remote)   MIC=$MIC_REMOTE_NAME ;;
            esac
            have_source "$MIC" || { echo "source not found: $MIC" >&2; exit 1; }
            SINK=${SINK:-$(pactl get-default-sink)}
            if [ "$SINK" = "$MIC_HARDWARE_JACK" ]; then
                echo "default sink is the NT-USB jack. Set SINK=..." >&2
                exit 1
            fi
            echo "capture : $MIC"
            echo "playback: $SINK"
            ID=$(pactl load-module module-loopback \
                source="$MIC" sink="$SINK" latency_msec=30 \
                source_dont_move=true sink_dont_move=true)
            echo "$ID" > "$MON_STATE"
            echo "monitor module $ID"
            ;;
        *) echo "micctl monitor hardware|filtered|remote|stop" >&2; exit 1 ;;
    esac
}

# --- vban rx -------------------------------------------------------------
cmd_rx() {
    case "${1:-}" in
        on)
            write_conf rx_template "$RX_VARS" "$RX_CONF"
            reload_pw
            echo "rx on ($MIC_REMOTE_NAME appears when a matching VBAN stream arrives)"
            ;;
        off)
            rm -f "$RX_CONF"
            echo "removed $RX_CONF"
            reload_pw
            ;;
        *) echo "micctl rx on|off" >&2; exit 1 ;;
    esac
}

# --- vban tx -------------------------------------------------------------
start_tx_loop() {
    unload_state "$TX_STATE"
    have_source "$MIC_FILTERED_NAME" || {
        echo "tx needs $MIC_FILTERED_NAME — run: micctl filter install" >&2
        exit 1
    }
    wait_sink "$MIC_VBAN_SINK" || {
        echo "missing sink $MIC_VBAN_SINK" >&2
        exit 1
    }
    ID=$(pactl load-module module-loopback \
        source="$MIC_FILTERED_NAME" sink="$MIC_VBAN_SINK" \
        latency_msec=20 source_dont_move=true sink_dont_move=true)
    echo "$ID" > "$TX_STATE"
    echo "tx loop module $ID  ($MIC_FILTERED_NAME -> $MIC_VBAN_SINK)"
}

cmd_tx() {
    case "${1:-}" in
        on)
            [ -n "$MIC_VBAN_DEST" ] || {
                echo "set MIC_VBAN_DEST to the other machine's LAN IP" >&2
                exit 1
            }
            write_conf tx_template "$TX_VARS" "$TX_CONF"
            reload_pw
            start_tx_loop
            ;;
        off)
            unload_state "$TX_STATE"
            rm -f "$TX_CONF"
            echo "removed $TX_CONF"
            reload_pw
            ;;
        *) echo "micctl tx on|off" >&2; exit 1 ;;
    esac
}

# --- main ----------------------------------------------------------------
cmd=${1:-status}
arg=${2:-}
case "$cmd" in
    status)           cmd_status ;;
    filter)           cmd_filter "$arg" ;;
    monitor)          cmd_monitor "$arg" ;;
    rx)               cmd_rx "$arg" ;;
    tx)               cmd_tx "$arg" ;;
    -h|--help|help)   usage ;;
    *) usage; exit 1 ;;
esac
