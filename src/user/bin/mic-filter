#!/bin/bash
# Tuomo Björk
# Version 6
#
# DeepFilterNet + LSP LADSPA compressor/limiter virtual source.
# Requires: [ envsubst, libdeep_filter_ladspa.so, lsp-plugins-ladspa.so ]
#
# v6  2026-09-11  tuned defaults: parallel 2:1, thresh 0.25, makeup 2.2, 5ms lookahead
# v5  2026-09-11  knob comments; default DFN atten 48
# v4  2026-09-11  real LADSPA port names + explicit L/R links
# v3  LSP LADSPA (URI labels), short control symbols (mistake)
# v2  LSP LV2 (resolve: cairo[X] conflict)
# v1  DeepFilter only for BG suppression
set -eu
MIC_FILTER_VERSION=6

# Microphone Source
export MIC_HARDWARE_SOURCE="${MIC_HARDWARE_SOURCE:-alsa_input.usb-RODE_Microphones_RODE_NT-USB-00.analog-stereo}"
# Virtual (filtered output) Source
export MIC_FILTERED_NAME="${MIC_FILTERED_NAME:-mic_filtered}"
export MIC_FILTERED_DESC="${MIC_FILTERED_DESC:-Mic Filtered}"
export MIC_FILTERED_CAPTURE_NAME="${MIC_FILTERED_CAPTURE_NAME:-${MIC_FILTERED_NAME}_capture}"


# 1. DeepFilterNet
# note: Background noise suppression.
#       Higher may thin consonants or add watery artifacts if the room is already clean.
#
# MIC_DF_ATTEN = max noise cut in dB. 12 mild, 24 light, 48 stronger, 100 uncapped.
export MIC_DF_PLUGIN="${MIC_DF_PLUGIN:-/usr/lib64/libdeep_filter_ladspa.so}"
export MIC_DF_ATTEN="${MIC_DF_ATTEN:-48}"

export MIC_LSP_PLUGIN="${MIC_LSP_PLUGIN:-/usr/lib64/ladspa/lsp-plugins-ladspa.so}"
export MIC_COMP_LABEL="${MIC_COMP_LABEL:-http://lsp-plug.in/plugins/ladspa/compressor_stereo}"
export MIC_LIMIT_LABEL="${MIC_LIMIT_LABEL:-http://lsp-plug.in/plugins/ladspa/limiter_stereo}"


# 2. Compressor
# note: Levels parked vs close.
#
# MIC_COMP_MODE      0 downward (tame close)  1 upward (lift quiet)  2 parallel
# MIC_COMP_RATIO     2 gentle  3 default  6 heavy
# MIC_COMP_THRESH    linear gain, 10^(dB/20). 0.25~-12dB  0.14~-17dB  0.10~-20dB
#                    Lower threshold = more compression on close speech.
# MIC_COMP_ATTACK    ms. 10-20 keeps consonants. Plugin default 0 is too fast.
# MIC_COMP_RELEASE   ms. 100-200 typical for voice.
# MIC_COMP_MAKEUP    linear gain after compress. 1.0 unity  1.8~+5dB  2.2~+7dB
#                    Raise if parked is still quiet after thresh is set.
# MIC_COMP_LOOKAHEAD ms. 0 = no extra delay. 5-10 catches peaks earlier.
export MIC_COMP_MODE="${MIC_COMP_MODE:-2}"
export MIC_COMP_RATIO="${MIC_COMP_RATIO:-2}"
export MIC_COMP_THRESH="${MIC_COMP_THRESH:-0.25}"
export MIC_COMP_ATTACK="${MIC_COMP_ATTACK:-20}"
export MIC_COMP_RELEASE="${MIC_COMP_RELEASE:-180}"
export MIC_COMP_MAKEUP="${MIC_COMP_MAKEUP:-2.2}"
export MIC_COMP_LOOKAHEAD="${MIC_COMP_LOOKAHEAD:-5}"


# 3. Limiter.
# note: Brick wall so makeup cannot slam voice chat.
#
# MIC_LIMIT_THRESH     linear. 1.0 = 0dBFS  0.79~-2dB  0.63~-4dB
# MIC_LIMIT_LOOKAHEAD  ms. 0 = no extra delay. 5 is cleaner on shouts.
export MIC_LIMIT_THRESH="${MIC_LIMIT_THRESH:-0.79}"
export MIC_LIMIT_LOOKAHEAD="${MIC_LIMIT_LOOKAHEAD:-5}"

CONF_DST="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d/99-${MIC_FILTERED_NAME}.conf"

usage() {
    printf '%s\n' \
        "Usage: $0 install|remove|status" \
        "Env: MIC_HARDWARE_SOURCE MIC_FILTERED_NAME MIC_DF_ATTEN" \
        "     MIC_COMP_MODE MIC_COMP_RATIO MIC_COMP_THRESH MIC_COMP_MAKEUP" \
        "     MIC_LIMIT_THRESH"
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "missing command: $1" >&2
        exit 1
    }
}

template() {
    cat <<'EOF'
# Generated by mic-filter.sh — do not edit; re-run install.
context.modules = [
    { name = libpipewire-module-filter-chain
        args = {
            node.description = "${MIC_FILTERED_DESC}"
            media.name       = "${MIC_FILTERED_DESC}"
            audio.rate       = 48000
            audio.channels   = 2
            audio.position   = [ FL FR ]
            filter.graph = {
                nodes = [
                    {
                        type   = ladspa
                        name   = df
                        plugin = ${MIC_DF_PLUGIN}
                        label  = deep_filter_stereo
                        control = {
                            "Attenuation Limit (dB)" = ${MIC_DF_ATTEN}
                        }
                    }
                    {
                        type   = ladspa
                        name   = comp
                        plugin = ${MIC_LSP_PLUGIN}
                        label  = "${MIC_COMP_LABEL}"
                        control = {
                            "Compression mode" = ${MIC_COMP_MODE}
                            "Ratio" = ${MIC_COMP_RATIO}
                            "Attack threshold (G)" = ${MIC_COMP_THRESH}
                            "Attack time (ms)" = ${MIC_COMP_ATTACK}
                            "Release time (ms)" = ${MIC_COMP_RELEASE}
                            "Makeup gain (G)" = ${MIC_COMP_MAKEUP}
                            "Sidechain lookahead (ms)" = ${MIC_COMP_LOOKAHEAD}
                        }
                    }
                    {
                        type   = ladspa
                        name   = lim
                        plugin = ${MIC_LSP_PLUGIN}
                        label  = "${MIC_LIMIT_LABEL}"
                        control = {
                            "Threshold (G)" = ${MIC_LIMIT_THRESH}
                            "Lookahead (ms)" = ${MIC_LIMIT_LOOKAHEAD}
                        }
                    }
                ]
                links = [
                    { output = "df:Audio Out L" input = "comp:Input L" }
                    { output = "df:Audio Out R" input = "comp:Input R" }
                    { output = "comp:Output L"  input = "lim:Input L" }
                    { output = "comp:Output R"  input = "lim:Input R" }
                ]
            }
            capture.props = {
                node.name     = "${MIC_FILTERED_CAPTURE_NAME}"
                node.passive  = true
                target.object = "${MIC_HARDWARE_SOURCE}"
            }
            playback.props = {
                node.name        = "${MIC_FILTERED_NAME}"
                node.description = "${MIC_FILTERED_DESC}"
                media.class      = "Audio/Source"
                audio.rate       = 48000
            }
        }
    }
]
EOF
}

status() {
    echo "version  : $MIC_FILTER_VERSION"
    echo "hardware : $MIC_HARDWARE_SOURCE"
    echo "filtered : $MIC_FILTERED_NAME"
    echo "df       : $( [ -f "$MIC_DF_PLUGIN" ] && echo "$MIC_DF_PLUGIN" || echo missing )"
    echo "lsp      : $( [ -f "$MIC_LSP_PLUGIN" ] && echo "$MIC_LSP_PLUGIN" || echo missing )"
    echo "atten    : ${MIC_DF_ATTEN} dB"
    echo "comp     : mode=$MIC_COMP_MODE ratio=$MIC_COMP_RATIO thresh=$MIC_COMP_THRESH makeup=$MIC_COMP_MAKEUP"
    echo "limit    : thresh=$MIC_LIMIT_THRESH"
    echo "drop-in  : $( [ -f "$CONF_DST" ] && echo "$CONF_DST" || echo "not installed" )"
    echo "default  : $(pactl get-default-source 2>/dev/null || echo '?')"
    pactl list short sources 2>/dev/null | grep -E "$MIC_HARDWARE_SOURCE|$MIC_FILTERED_NAME" || true
}

install_conf() {
    need envsubst
    [ -f "$MIC_DF_PLUGIN" ] || { echo "missing $MIC_DF_PLUGIN" >&2; exit 1; }
    [ -f "$MIC_LSP_PLUGIN" ] || { echo "missing $MIC_LSP_PLUGIN" >&2; exit 1; }
    mkdir -p "$(dirname "$CONF_DST")"
    template | envsubst '${MIC_HARDWARE_SOURCE} ${MIC_FILTERED_NAME} ${MIC_FILTERED_DESC} ${MIC_FILTERED_CAPTURE_NAME} ${MIC_DF_PLUGIN} ${MIC_DF_ATTEN} ${MIC_LSP_PLUGIN} ${MIC_COMP_LABEL} ${MIC_LIMIT_LABEL} ${MIC_COMP_MODE} ${MIC_COMP_RATIO} ${MIC_COMP_THRESH} ${MIC_COMP_ATTACK} ${MIC_COMP_RELEASE} ${MIC_COMP_MAKEUP} ${MIC_COMP_LOOKAHEAD} ${MIC_LIMIT_THRESH} ${MIC_LIMIT_LOOKAHEAD}' > "$CONF_DST"
    echo "version $MIC_FILTER_VERSION"
    echo "wrote $CONF_DST"
    echo "restart: systemctl --user restart pipewire pipewire-pulse wireplumber"
}

remove_conf() {
    rm -f "$CONF_DST"
    echo "removed $CONF_DST"
    echo "restart: systemctl --user restart pipewire pipewire-pulse wireplumber"
}

cmd=${1:-status}
case "$cmd" in
    status)  status ;;
    install) install_conf ;;
    remove)  remove_conf ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
